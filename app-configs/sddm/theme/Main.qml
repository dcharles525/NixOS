// SDDM greeter laid out to match hyprlock (app-configs/hypr/hyprlock.nix).
// Offsets are hyprlock's `position` values with y flipped; font sizes are
// hyprlock's pt values converted to px (x 4/3). Palette, user and the sleep
// action come from theme.conf, generated by app-configs/sddm/default.nix.
import QtQuick

Rectangle {
    id: root

    readonly property color bg: config.bg
    readonly property color ink: config.ink
    readonly property color inkDim: config.inkDim
    readonly property color warn: config.warn
    readonly property color alert: config.alert
    readonly property color bgGlass: Qt.rgba(bg.r, bg.g, bg.b, 0.85)

    // "", "checking" or "failed". Drives the input outline color.
    property string authState: ""
    property date now: new Date()

    color: bg

    function login() {
        if (password.text.length === 0)
            return
        authState = "checking"
        sddm.login(config.user, password.text, sessionModel.lastIndex)
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            root.authState = "failed"
            password.text = ""
        }
    }

    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: root.now = new Date()
    }

    // Pre-blurred at build time, so the greeter needs no shader effects.
    Image {
        anchors.fill: parent
        source: "background.jpg"
        fillMode: Image.PreserveAspectCrop
    }

    // DATE
    Text {
        anchors.centerIn: parent
        anchors.verticalCenterOffset: -300
        text: Qt.formatDate(root.now, "dddd '//' MMMM dd").toUpperCase()
        color: root.inkDim
        font.family: "JetBrainsMono Nerd Font"
        font.pixelSize: 21
    }

    // TIME
    Text {
        anchors.centerIn: parent
        anchors.verticalCenterOffset: -200
        text: (root.now.getHours() % 12 || 12) + ":"
            + String(root.now.getMinutes()).padStart(2, "0")
        color: root.ink
        font.family: "JetBrainsMono Nerd Font"
        font.weight: Font.ExtraLight
        font.pixelSize: 147
    }

    // INPUT FIELD
    Rectangle {
        anchors.centerIn: parent
        anchors.verticalCenterOffset: 200
        width: 350
        height: 60
        radius: height / 2
        color: root.bgGlass
        border.width: 1
        border.color: root.authState === "failed" ? root.alert
            : root.authState === "checking" ? root.warn
            : root.ink

        Text {
            anchors.centerIn: parent
            visible: password.text.length === 0
            text: "INPUT : PASSWORD_"
            color: root.inkDim
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 16
        }

        TextInput {
            id: password
            anchors.fill: parent
            anchors.leftMargin: 24
            anchors.rightMargin: 24
            horizontalAlignment: TextInput.AlignHCenter
            verticalAlignment: TextInput.AlignVCenter
            clip: true
            focus: true
            echoMode: TextInput.Password
            passwordCharacter: "●"
            color: root.ink
            font.pixelSize: 14
            font.letterSpacing: 5
            cursorDelegate: Item {}
            onTextEdited: root.authState = ""
            onAccepted: root.login()
        }
    }

    // MGX: hover inverts.
    component RoundButton: Rectangle {
        id: button

        property alias icon: glyph.text
        signal clicked()

        width: 46
        height: 46
        radius: height / 2
        color: area.containsMouse ? root.ink : root.bgGlass
        border.width: 1
        border.color: root.ink

        Text {
            id: glyph
            anchors.centerIn: parent
            color: area.containsMouse ? root.bg : root.ink
            font.family: "Symbols Nerd Font"
            font.pixelSize: 24
        }

        MouseArea {
            id: area
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: button.clicked()
        }
    }

    // SLEEP BUTTON
    RoundButton {
        anchors.centerIn: parent
        anchors.horizontalCenterOffset: -34
        anchors.verticalCenterOffset: 290
        icon: "󰒲"
        onClicked: config.sleep === "hibernate" ? sddm.hibernate()
            : sddm.suspend()
    }

    // SHUTDOWN BUTTON
    RoundButton {
        anchors.centerIn: parent
        anchors.horizontalCenterOffset: 34
        anchors.verticalCenterOffset: 290
        icon: "󰐥"
        onClicked: sddm.powerOff()
    }
}
