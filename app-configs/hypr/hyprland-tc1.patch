diff --git a/src/protocols/core/Output.cpp b/src/protocols/core/Output.cpp
index 9278eb95..858febb4 100644
--- a/src/protocols/core/Output.cpp
+++ b/src/protocols/core/Output.cpp
@@ -2,6 +2,40 @@
 #include "Compositor.hpp"
 #include "../../Compositor.hpp"
 #include "../../helpers/Monitor.hpp"
+#include "../../managers/eventLoop/EventLoopManager.hpp"
+
+struct SRetiredOutputGlobal {
+    SP<CWLOutputProtocol> proto;
+    SP<CEventLoopTimer>   timer;
+};
+
+// Holds removed-but-not-yet-destroyed wl_output globals so that clients with
+// in-flight wl_registry.bind requests are not killed by an "invalid global"
+// protocol error. Intentionally heap-allocated and never freed: the entries may
+// still hold Wayland globals at exit, and a static destructor would destroy
+// them after the wl_display is gone.
+static std::vector<SP<SRetiredOutputGlobal>>& s_retiredOutputGlobals = *new std::vector<SP<SRetiredOutputGlobal>>();
+
+void retireWLOutputGlobal(SP<CWLOutputProtocol> proto) {
+    if (!proto)
+        return;
+
+    if (!proto->isDefunct())
+        proto->remove();
+
+    auto entry   = makeShared<SRetiredOutputGlobal>();
+    entry->proto = proto;
+    // The grace period only needs to cover a client round-trip; 10s is generous.
+    entry->timer = makeShared<CEventLoopTimer>(
+        std::chrono::seconds(10),
+        [raw = entry.get()](SP<CEventLoopTimer> self, void*) {
+            std::erase_if(s_retiredOutputGlobals, [&](const auto& e) { return e.get() == raw; });
+        },
+        nullptr);
+
+    s_retiredOutputGlobals.emplace_back(entry);
+    g_pEventLoopManager->addTimer(entry->timer);
+}
 
